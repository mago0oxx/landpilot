DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landpilot"
# Free, no cost — get one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=""

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Optional — Google sign-in is disabled until both are set. Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — AI-generated summary/action items and market research are skipped until set.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Optional — paid plan upgrade/billing is disabled until these are set. Create a test-mode
# secret key and recurring Prices at https://dashboard.stripe.com/test/products
# (Starter $9.99/mo, Pro $29.99/mo)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
# Get with: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Optional — without this, password reset links are logged to the server console instead of
# emailed. Free tier at https://resend.com/api-keys
RESEND_API_KEY=""
# Sender shown on password reset emails — only works out of the box with Resend's sandbox
# domain until you verify your own domain at https://resend.com/domains
EMAIL_FROM="LandPilot <onboarding@resend.dev>"

# Optional — error monitoring is disabled until this is set. Free tier at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — needed only to upload readable (un-minified) source maps on build.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional — product analytics (signups, analyses run, checkout funnel) is disabled until
# this is set. Free tier at https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
